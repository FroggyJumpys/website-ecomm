# Copy this file to `.env` and adjust the values for your machine.
# `.env` is git-ignored; never commit real secrets.

NODE_ENV=development
PORT=4000

# Must match the Vite dev server origin for credentialed CORS.
CLIENT_ORIGIN=http://localhost:5173

# Matches docker-compose.yml (docker compose up -d db)
DATABASE_URL=postgres://ba_dekor:ba_dekor@localhost:5432/ba_dekor

# At least 24 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=development-only-secret-change-me
JWT_EXPIRES_IN=7d
COOKIE_NAME=ba_dekor_session

# Integration tests (npm run test:integration). The URL must name a database
# ending in `_test`; the harness refuses anything else. When unset, it uses
# DATABASE_URL with `<name>_test` appended.
# TEST_DATABASE_URL=postgres://ba_dekor:ba_dekor@localhost:5432/ba_dekor_test

# bcrypt cost factor. 10 is a reasonable default for a course project.
BCRYPT_ROUNDS=10

# Where uploaded catalogue images are written. Relative paths resolve from
# `server/`, so the default is `server/uploads/catalog`. Point this at a mounted
# volume in production: uploads are not part of the database and do not survive
# a container rebuild unless the directory is persisted. Back this directory up
# alongside the database — the product and order history reference these files.
# UPLOAD_DIR=uploads/catalog

# Where the seeded `/images/...` assets live, used only to check that a product's
# image path exists before it is saved. Defaults to `client/public/images` in
# development and `client/dist/images` in a production build.
# PUBLIC_IMAGE_DIR=../client/public/images
